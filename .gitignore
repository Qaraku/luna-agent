# Generated binaries for the root app and historical spikes.
**/.runtime/

# Local-only verification evidence and captured logs.
**/.evidence/
**/local-evidence/
**/*.log

# Local-only multi-agent coordination state (handoff, backlog, heartbeat).
/.hermes/

# Persistent cooperative data locks and format markers; never commit private lifecycle state.
.luna-data-*.lock
.luna-data-format.json
.luna-restore-pending
